<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:visibility="visible"
    tools:visibility="visible">

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2196F3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <!-- 连接状态指示 -->
        <View
            android:id="@+id/v_conn_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/circle_red" />

        <TextView
            android:id="@+id/tv_conn_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="未连接"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="连接"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ==================== 信号强度区 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="电台信号强度"
                android:textColor="#666666"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/pb_signal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:max="30"
                android:progress="0"
                android:progressTint="#4CAF50" />

            <TextView
                android:id="@+id/tv_rssi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="RSSI --"
                android:textColor="#666666"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_stereo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="立体声 "
                android:textAlignment="textEnd"
                android:textColor="#999999"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_band"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"

                android:text="FM 广播"
                android:textAlignment="viewStart"
                android:textColor="#999999"
                android:textSize="14sp" />


        </LinearLayout>
    </LinearLayout>
    <!-- ==================== 频率显示区 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- 频率大字 -->
        <LinearLayout
            android:id="@+id/tv_freq_Layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="invisible">

            <TextView
                android:id="@+id/tv_freq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="--.--"
                android:textColor="#1A1A1A"
                android:textSize="60sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="MHz"
                android:textColor="#888888"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 调谐按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_tune_down"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:background="@drawable/btn_tune_bg"
                android:stateListAnimator="@null"
                android:text="◀"
                android:textColor="@color/btn_tune_text"
                android:textSize="24sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_tune_up"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/btn_tune_bg"
                android:stateListAnimator="@null"
                android:text="▶"
                android:textColor="@color/btn_tune_text"
                android:textSize="24sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>


    <!-- ==================== 音量区 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textColor="#666666"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/sb_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:max="15"
            android:progress="8" />

        <TextView
            android:id="@+id/tv_volume"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:text="8"
            android:textColor="#1A1A1A"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ==================== 主控制按钮 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="1dp"
        android:paddingEnd="16dp"
        android:paddingBottom="1dp">

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#2196F3"
            android:text="搜台"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_mute"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="静音"
            android:textColor="#2196F3" />

        <Button
            android:id="@+id/btn_mono"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="单声道"
            android:textColor="#2196F3" />
    </LinearLayout>

    <!-- ==================== 电源控制 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="1dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_power_off"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="关机"
            android:textColor="#2196F3" />



        <Button
            android:id="@+id/btn_soft_reset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#E3F2FD"
            android:text="开机"
            android:textColor="#2196F3" />
    </LinearLayout>

    <!-- ==================== 电台列表标题 ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="电台列表"
            android:textColor="#666666"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_station_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 个"
            android:textColor="#999999"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ==================== 电台列表 ==================== -->
    <ListView
        android:id="@+id/lv_stations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp" />

    <!-- ==================== 底部状态栏 ==================== -->
    <TextView
        android:id="@+id/tv_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#333333"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:padding="8dp"
        android:text="就绪"
        android:textColor="#CCCCCC"
        android:textSize="12sp" />

</LinearLayout>